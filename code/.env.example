# Environment configuration template — Buy or Wait?
# Copy this to .env (repo root) and fill in your values.
# NEVER commit .env to git.

# Required: Groq API key (get yours at https://console.groq.com)
GROQ_API_KEY=

# Auto-populated by: python code/scripts/setup_models.py
# Strongest available Groq chat model with JSON/tool-mode support
GROQ_TEXT_MODEL=llama-3.3-70b-versatilellama-3.3-70b-versatile

# Auto-populated by: python code/scripts/setup_models.py
# Strongest available Groq vision model (or "ocr_fallback" if none available)
GROQ_VISION_MODEL=ocr_fallbackocr_fallback
